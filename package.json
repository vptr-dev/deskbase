{
  "name": "planner",
  "productName": "Planner",
  "version": "0.1.0",
  "description": "A clean local planner and life tracker.",
  "main": "./out/main/index.js",
  "author": "vptr-dev",
  "license": "MIT",
  "homepage": "https://github.com/vptr-dev/planner",
  "repository": {
    "type": "git",
    "url": "https://github.com/vptr-dev/planner.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs",
    "dev:web": "vite --config vite.web.config.ts"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "immer": "10.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "44.11.4",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@44.11.4": true
  }
}
